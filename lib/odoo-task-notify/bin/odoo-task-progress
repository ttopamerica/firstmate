#!/usr/bin/env python3
"""Post one executed Start Firstmate step. Refuses a later step before earlier ones."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
from bridge.odoo import Json2
from bridge.progress import post_step


def env():
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "config.env")
    out = {}
    with open(path) as handle:
        for line in handle:
            if not line.strip() or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            out[key] = value.strip().strip('"').strip("'")
    return out


def main(argv):
    if len(argv) < 3 or argv[0] in ("-h", "--help"):
        print("usage: odoo-task-progress <odoo-id> <step 1-6> --outcome TEXT", file=sys.stderr)
        return 2
    oid, step = int(argv[0]), int(argv[1])
    if "--outcome" not in argv[2:]:
        print("error: --outcome is required", file=sys.stderr)
        return 2
    outcome = " ".join(argv[argv.index("--outcome") + 1:])
    config = env()
    key = open(config["ODOO_API_KEY_FILE"]).read().strip()
    client = Json2(config["ODOO_URL"], config["ODOO_DB"], key)
    print(post_step(client, oid, step, outcome))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
